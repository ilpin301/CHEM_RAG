### LLM: Z.ai GLM coding-plan endpoint (OpenAI-compatible)
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.z.ai/api/coding/paas/v4
LLM_BINDING_API_KEY=
LLM_MODEL=glm-5.3

### Vision model for images inside documents
VLM_PROCESS_ENABLE=true
VLM_LLM_BINDING=openai
VLM_LLM_BINDING_HOST=https://api.z.ai/api/coding/paas/v4
VLM_LLM_BINDING_API_KEY=
VLM_LLM_MODEL=glm-4.5v

### Embeddings: local Ollama (Z.ai plan has no embedding endpoint)
EMBEDDING_BINDING=ollama
EMBEDDING_BINDING_HOST=http://host.docker.internal:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=8192

### Server
HOST=0.0.0.0
PORT=9621
LIGHTRAG_API_KEY=
WEBUI_TITLE=CHEM_RAG
SUMMARY_LANGUAGE=English
COMPOSE_PROJECT_NAME=chem_rag

### Vector backend. Flip to QdrantVectorDBStorage ONLY after
### migrate_nano_to_qdrant.py --apply has finished and verify_qdrant_recall.py
### has passed: setting it first points the server at an empty index.
LIGHTRAG_VECTOR_STORAGE=QdrantVectorDBStorage
### Host-side URL for the kit scripts. The container gets http://qdrant:6333
### from docker-compose.yml instead. 6343, not 6333: PCM_RAG holds 6333.
QDRANT_PORT=6353
QDRANT_URL=http://127.0.0.1:6353
